scale 1;

// One user-controlled refinement factor and all derived quantities
#include "meshControls"

centralCellSize #eval "$baseCellSize/$centralRefinementFactor";

// Central box dimensions: 0.020 x 0.020 x 0.028 m
nCentralXY #eval "round(0.020/$centralCellSize)";
nCentralZ  #eval "round(0.028/$centralCellSize)";

// Number of cells normal to the outer side/top/bottom slabs.
// These are deliberately kept modest; grading makes the cell adjacent
// to the central box exactly centralCellSize and grows outward.
nOuterXY 4;
nOuterZ  3;

// Exact simpleGrading for the 10-mm outer x/y slabs with 4 cells.
// Solve t^3+t^2+t+1 = L/h analytically, then grading = 1/t^3.
Sxy #eval "0.010/$centralCellSize";
Qxy #eval "20.0/27.0-$Sxy";
Dxy #eval "sqr($Qxy/2.0)+pow(2.0/9.0,3)";
Txy #eval "cbrt(-$Qxy/2.0+sqrt($Dxy))+cbrt(-$Qxy/2.0-sqrt($Dxy))-1.0/3.0";
gXY    #eval "1.0/pow($Txy,3)";
gXYinv #eval "1.0/$gXY";

// Exact simpleGrading for the 6-mm outer z slabs with 3 cells.
// Solve t^2+t+1 = L/h, then grading = 1/t^2.
Sz #eval "0.006/$centralCellSize";
Tz #eval "(-1.0+sqrt(4.0*$Sz-3.0))/2.0";
gZ    #eval "1.0/sqr($Tz)";
gZinv #eval "1.0/$gZ";


