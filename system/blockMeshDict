// y = -0.020, -0.010, 0.010, 0.020
// z = -0.020, -0.014, 0.014, 0.020
//
// The central box is [-0.010,0.010] x [-0.010,0.010] x [-0.014,0.014].
// With 2 mm cells, it extends by two complete cell layers beyond the
// effective setFields region in every direction.

