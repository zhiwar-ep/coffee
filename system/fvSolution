FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(rho|rhoFinal)"
    {
        solver          diagonal;
    }

  p
{
    solver          PCG;
    preconditioner  DIC;
    tolerance       1e-5;
    relTol          0.05;
}

pFinal
{
    $p;
    tolerance       1e-6;
    relTol          0;
}


    "(U|h|Yi|Ys|Ym|porosity)"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-06;
        relTol          0.01;
    }

    "(U|h|Yi|Ys|Ym|porosity)Final"
    {
        $U;
        relTol      0;
    }   



Ts
{
    solver          PBiCGStab;
    preconditioner  DILU;
    tolerance       1e-7;
    relTol          1e-3;
    maxIter         200;
}

    rhos
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-06;
        relTol          0;
    }

    G
    {
        $p;
        tolerance       1e-05;
        relTol          1e-2;
    }

    GFinal
    {
        $G;
        relTol          0;
    }


"(Us|UsDEMInterpolation)"
{
    solver          smoothSolver;
    smoother        symGaussSeidel;
    tolerance       1e-6;
    relTol          0.01;
}

