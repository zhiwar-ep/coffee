    solidH
{
    solver          PCG;
    preconditioner  DIC;
    tolerance       1e-8;
    relTol          1e-3;
}

}


PIMPLE
{
    momentumPredictor yes;
    nOuterCorrectors  1;
    nCorrectors     1;
    nNonOrthogonalCorrectors 0;
}


