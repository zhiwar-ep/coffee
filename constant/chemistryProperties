FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidThermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistry           on;

chemistryType
{
    solver            ode;
}

solidChemistryType
{
    solver              solidOde;
    method              ODESolidHeterogeneousChemistryModel;
    solidThermoType     const<constRad<constThermo<constRho>>>;
}

chemistrySolver     ode;

solidChemistrySolver	solidOde;

initialChemicalTimeStep 1e-1;

turbulentReaction   off;
solidReactionEnergyFromEnthalpy false;
stoichiometricReactions false;
showRelativeReactionRates false;

solidChemistryTimeStepControl true;

odeCoeffs
{
    solver          seulex;
}

solidOdeCoeffs
{
    //solver      seulex; //old solver

    // Explicit adaptive Runge-Kutta solver.
    // The old solid chemistry Jacobian is not fully consistent with
    // the derivatives used by the ODE system. RKF45 uses the actual
    // derivatives directly and does not rely on that Jacobian.
    solver      RKF45;

    // The OpenFOAM default absolute tolerance is SMALL, which is too
    // restrictive for product species that initially have zero
    // concentration.
    absTol      1e-8;

    // Retain the normal relative accuracy used by OpenFOAM ODE solvers.
    relTol      1e-4;

    // Keep the standard limit. Raising this value would only hide the
    // underlying extremely small chemistry steps.
    maxSteps    10000;
}


species
(
    H2O
    Vearly Vlate

);



solidReactions
(
    // Moisture removal
    irreversibleSolidArrheniusHeterogeneousReaction
    moist = H2O
    (200  4.10e3  300  0.0e0  1)


    // Raw -> Yellow
    // 1.5% mass released as early volatile
    irreversibleSolidArrheniusHeterogeneousReaction
    raw = 0.984 yellow + 0.015 Vearly + 0.001 Color
    (1.10  2.15e3  300  0.0e0  1)


    // Yellow -> Crack
    // 4% mass released as early volatile
    irreversibleSolidArrheniusHeterogeneousReaction
    yellow = 0.96 crack + 0.04 Vearly
    (6.39  3.15e3  300  0.0e0  1)


    // Crack -> Dev
    // 7% mass released as late volatile
    irreversibleSolidArrheniusHeterogeneousReaction
    crack = 0.93 dev + 0.07 Vlate
    (2.21e5  9.49e3  300  0.0e0  1)


    // Dev -> Dark
    // 7.5% additional volatile loss
    irreversibleSolidArrheniusHeterogeneousReaction
    dev = 0.875 dark + 0.075 Vlate + 0.02 Color + 0.03 Burnt
    (5.17e9  1.50e4  300  0.0e0  1)


    // Early volatile -> Late volatile
    irreversibleSolidArrheniusHeterogeneousReaction
    Vearly = 1.0 Vlate
    (0.113  3.47e3  300  0.0e0  1)
);

